* {
    font-family: "${FONT_FAMILY}", sans-serif;
    font-size: ${FONT_SIZE_WAYBAR}px;
    min-height: 0;
    border: none;
    border-radius: 0;
    box-shadow: none;
    text-shadow: none;
}

window#waybar {
    background: transparent;
}

/* Three floating islands (apps / workspaces+clock / tray+quicksettings)
   instead of one continuous flat strip -- this is what actually reads as
   "a compact floating dock" rather than "waybar with some colors changed."
   Each island shares the exact same translucent-glass language the
   Quickshell panels use, and the real gaps between them stay fully
   transparent so the wallpaper -- already blurred behind each island via
   hyprland.lua's waybar-blur layer_rule -- stays visible in between, not
   just underneath. Radius is deliberately well short of half this
   island's own height: a clearly rounded RECTANGLE, not a stadium/pill --
   a large radius on a short bar reads as a capsule the instant it passes
   that point, which is exactly the "wavy/blobby" look this is avoiding. */
#waybar > box > box.modules-left,
#waybar > box > box.modules-center,
#waybar > box > box.modules-right {
    background-color: rgba(${BG_R}, ${BG_G}, ${BG_B}, ${OPACITY_IDLE});
    border: 1px solid rgba(${TEXT_ACTIVE_R}, ${TEXT_ACTIVE_G}, ${TEXT_ACTIVE_B}, ${BORDER_OPACITY_IDLE});
    border-radius: ${RADIUS_BAR}px;
    padding: 0 6px;
    margin: 6px 4px;
}

/* Master container transparency -- these sit *inside* an island now, so
   they stay bare rather than doubling up their own background. */
#hyprland-workspaces,
#workspaces {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 4px;
}

/* Strip native GTK button rendering engine styles. Idle state is
   deliberately bare -- no fill, no border -- so a row of icons reads as
   quiet chrome and not a strip of boxes; a hover/active state is what
   earns any color at all. */
#hyprland-workspaces button,
#workspaces button,
button {
    background-image: none;
    background-color: transparent;
    color: ${TEXT_COLOR};
    padding: 4px 12px;
    margin: 3px 2px;
    border-radius: ${RADIUS}px;
    box-shadow: none;
    text-shadow: none;
    transition: background-color 140ms cubic-bezier(0.2, 0, 0, 1), color 140ms cubic-bezier(0.2, 0, 0, 1), min-width 140ms cubic-bezier(0.2, 0, 0, 1);
}

/* Clock and app-shortcut icons stay text-only at rest too -- no
   permanently-visible pill behind every single module. */
#clock,
.modules-left widget > * {
    background-color: transparent;
    background-image: none;
    color: ${TEXT_COLOR};
    padding: 4px 12px;
    margin: 3px 2px;
    border-radius: ${RADIUS}px;
    transition: background-color 140ms cubic-bezier(0.2, 0, 0, 1), color 140ms cubic-bezier(0.2, 0, 0, 1);
}

#clock {
    font-weight: 600;
    color: ${TEXT_ACTIVE_COLOR};
}

/* The tray sits on the shared right-hand island surface now -- no second
   background of its own, just its own spacing. */
#tray {
    background: transparent;
    padding: 2px 10px;
    margin: 3px 2px;
}

/* Custom-image shortcuts ("pfps"): square avatar clipped to the same
   corner radius as everything else, sized to match icon shortcuts. */
#image {
    padding: 2px;
    background: transparent;
}

/* Quick Settings cluster: volume/wifi/cpu/ram grouped into one row of
   segments, clicking any segment opens the Quick Settings panel. It sits
   on the same right-hand island surface as the tray now, rather than
   getting its own nested pill -- one shared surface per island, not one
   per widget. */
#quicksettings {
    background: transparent;
    margin: 3px 2px;
    padding: 0 4px;
}

#quicksettings widget > * {
    background: none;
    color: ${TEXT_COLOR};
    padding: 4px 11px;
    margin: 3px 0;
    border-radius: ${RADIUS}px;
    transition: background-color 140ms cubic-bezier(0.2, 0, 0, 1), color 140ms cubic-bezier(0.2, 0, 0, 1);
}

#quicksettings widget > *:hover {
    background-color: rgba(${ACCENT_R}, ${ACCENT_G}, ${ACCENT_B}, 0.22);
    color: ${TEXT_ACTIVE_COLOR};
}

/* Active/focused workspace: a solid accent pill, the one saturated color
   note on the whole bar -- everything else stays monochrome so this
   actually reads as "the thing that's on" instead of blending in. */
#hyprland-workspaces button.active,
#hyprland-workspaces button.focused,
#hyprland-workspaces button:checked,
#workspaces button.active,
#workspaces button.focused,
#workspaces button:checked,
button:checked,
button.active {
    background-image: none;
    background-color: rgba(${ACCENT_R}, ${ACCENT_G}, ${ACCENT_B}, 0.85);
    color: ${TEXT_ACTIVE_COLOR};
    box-shadow: none;
    text-shadow: none;
}

/* Hover effect -- a soft neutral fill, no border, on anything not already
   using the accent for its active state. */
#hyprland-workspaces button:hover,
#workspaces button:hover,
.modules-left widget > *:hover {
    background-image: none;
    background-color: rgba(${TEXT_ACTIVE_R}, ${TEXT_ACTIVE_G}, ${TEXT_ACTIVE_B}, 0.08);
    color: ${TEXT_ACTIVE_COLOR};
}

#tray > .needs-attention {
    background-color: rgba(${ACCENT_R}, ${ACCENT_G}, ${ACCENT_B}, 0.4);
    border-radius: 8px;
}

/* App-shortcut icons (launcher + custom taskbar buttons) size independently
   from the clock/volume/network/etc text modules above. */
.app-icon {
    font-size: ${FONT_SIZE_WAYBAR_ICONS}px;
}
