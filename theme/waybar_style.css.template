* {
    font-family: "${FONT_FAMILY}", sans-serif;
    font-size: ${FONT_SIZE_WAYBAR}px;
    min-height: 0;
    border: none;
    border-radius: 0;
    box-shadow: none;
    text-shadow: none;
}

window#waybar {
    background: transparent;
}

/* The left/right rails hold exactly one island each (no multiple-island
   gaps to preserve the way the top/dock bars have), so any transparent
   sliver inside their own window bounds beyond the island's rounded
   fill is just a leftover gap with nothing to show but whatever's behind
   it -- close it completely rather than let it leak arbitrary window
   content when something happens to be floating behind that edge. */
window#waybar.waybar-left,
window#waybar.waybar-right {
    background-color: rgba(${BG_R}, ${BG_G}, ${BG_B}, ${WAYBAR_BG_ALPHA});
    border-radius: ${RADIUS_BAR}px;
}

/* Three floating islands (apps / workspaces+clock / tray+quicksettings)
   instead of one continuous flat strip -- this is what actually reads as
   "a compact floating dock" rather than "waybar with some colors changed."
   Each island shares the exact same translucent-glass language the
   Quickshell panels use, and the real gaps between them stay fully
   transparent so the wallpaper -- already blurred behind each island via
   hyprland.lua's waybar-blur layer_rule -- stays visible in between, not
   just underneath. Radius is deliberately well short of half this
   island's own height: a clearly rounded RECTANGLE, not a stadium/pill --
   a large radius on a short bar reads as a capsule the instant it passes
   that point, which is exactly the "wavy/blobby" look this is avoiding. */
#waybar > box > box.modules-left,
#waybar > box > box.modules-center,
#waybar > box > box.modules-right {
    background-color: rgba(${BG_R}, ${BG_G}, ${BG_B}, ${WAYBAR_BG_ALPHA});
    border: 1px solid rgba(${TEXT_ACTIVE_R}, ${TEXT_ACTIVE_G}, ${TEXT_ACTIVE_B}, ${BORDER_OPACITY_IDLE});
    border-radius: ${RADIUS_BAR}px;
    padding: 0 6px;
    margin: 6px 4px;
    transition: background-color 140ms cubic-bezier(0.2, 0, 0, 1);
}

/* Each bar is flush against the exact edge it belongs to (square on that
   side) and rounded only on the side facing into the desktop -- the same
   "square where attached, rounded where it floats free" geometry the
   panel each bar triggers already uses (top/left/right/dock config files
   set "name" to match). Opening Quick Settings or the Taskbar editor
   then reads as that bar's own surface extending, not an unrelated
   rectangle appearing elsewhere on screen. */
#waybar.waybar-top > box > box.modules-center {
    border-radius: 0 0 ${RADIUS_BAR}px ${RADIUS_BAR}px;
    margin: 0 4px 6px 4px;
}
#waybar.waybar-left > box > box.modules-center {
    border-radius: 0 ${RADIUS_BAR}px ${RADIUS_BAR}px 0;
    margin: 6px 4px 6px 0;
}
#waybar.waybar-right > box > box.modules-center {
    border-radius: ${RADIUS_BAR}px 0 0 ${RADIUS_BAR}px;
    margin: 6px 0 6px 4px;
}
#waybar.waybar-dock > box > box.modules-left {
    border-radius: ${RADIUS_BAR}px ${RADIUS_BAR}px 0 0;
    margin: 6px 4px 0 4px;
}

/* Master container transparency -- these sit *inside* an island now, so
   they stay bare rather than doubling up their own background. */
#hyprland-workspaces,
#workspaces {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 4px;
}

/* Strip native GTK button rendering engine styles. Idle state is
   deliberately bare -- no fill, no border -- so a row of icons reads as
   quiet chrome and not a strip of boxes; a hover/active state is what
   earns any color at all. */
#hyprland-workspaces button,
#workspaces button,
button {
    background-image: none;
    background-color: transparent;
    color: ${TEXT_COLOR};
    padding: 4px 12px;
    margin: 3px 2px;
    border-radius: ${RADIUS}px;
    box-shadow: none;
    text-shadow: none;
    transition: background-color 140ms cubic-bezier(0.2, 0, 0, 1), color 140ms cubic-bezier(0.2, 0, 0, 1), min-width 140ms cubic-bezier(0.2, 0, 0, 1);
}

/* Clock and app-shortcut icons stay text-only at rest too -- no
   permanently-visible pill behind every single module. */
#clock,
.modules-left widget > * {
    background-color: transparent;
    background-image: none;
    color: ${TEXT_COLOR};
    padding: 4px 12px;
    margin: 3px 2px;
    border-radius: ${RADIUS}px;
    transition: background-color 140ms cubic-bezier(0.2, 0, 0, 1), color 140ms cubic-bezier(0.2, 0, 0, 1);
}

#clock {
    font-weight: 600;
    color: ${TEXT_ACTIVE_COLOR};
}

/* The clock is clickable (opens the calendar) but previously gave zero
   interactive feedback -- a quiet hover tint says "this responds to you"
   without adding a permanent pill around it. */
#clock:hover {
    background-color: rgba(${TEXT_ACTIVE_R}, ${TEXT_ACTIVE_G}, ${TEXT_ACTIVE_B}, 0.08);
}

/* Idle quiet, alert on interaction: the left workspace rail and right
   status rail dim themselves slightly at rest and come to full
   brightness on hover or when actually active/focused -- the shell
   should be "there" without visually competing with the wallpaper the
   moment nothing is happening. */
#waybar.waybar-left button {
    opacity: 0.72;
    transition: opacity 160ms cubic-bezier(0.2, 0, 0, 1), background-color 140ms cubic-bezier(0.2, 0, 0, 1);
}
#waybar.waybar-left button:hover,
#waybar.waybar-left button.active,
#waybar.waybar-left button.focused,
#waybar.waybar-left button:checked {
    opacity: 1;
}
#waybar.waybar-right widget > * {
    opacity: 0.72;
    transition: opacity 160ms cubic-bezier(0.2, 0, 0, 1), background-color 140ms cubic-bezier(0.2, 0, 0, 1), color 140ms cubic-bezier(0.2, 0, 0, 1);
}
#waybar.waybar-right widget > *:hover {
    opacity: 1;
}

/* The tray sits on the shared right-hand island surface now -- no second
   background of its own, just its own spacing. */
#tray {
    background: transparent;
    padding: 2px 10px;
    margin: 3px 2px;
}

/* Custom-image shortcuts ("pfps"): square avatar clipped to the same
   corner radius as everything else, sized to match icon shortcuts. */
#image {
    padding: 2px;
    background: transparent;
}

/* Quick Settings cluster: volume/wifi/cpu/ram grouped into one row of
   segments, clicking any segment opens the Quick Settings panel. It sits
   on the same right-hand island surface as the tray now, rather than
   getting its own nested pill -- one shared surface per island, not one
   per widget. */
#quicksettings {
    background: transparent;
    margin: 3px 2px;
    padding: 0 4px;
}

#quicksettings widget > * {
    background: none;
    color: ${TEXT_COLOR};
    padding: 4px 11px;
    margin: 3px 0;
    border-radius: ${RADIUS}px;
    transition: background-color 140ms cubic-bezier(0.2, 0, 0, 1), color 140ms cubic-bezier(0.2, 0, 0, 1);
}

#quicksettings widget > *:hover {
    background-color: rgba(${ACCENT_R}, ${ACCENT_G}, ${ACCENT_B}, 0.22);
    color: ${TEXT_ACTIVE_COLOR};
}

/* Active/focused workspace: a solid accent pill, the one saturated color
   note on the whole bar -- everything else stays monochrome so this
   actually reads as "the thing that's on" instead of blending in. */
#hyprland-workspaces button.active,
#hyprland-workspaces button.focused,
#hyprland-workspaces button:checked,
#workspaces button.active,
#workspaces button.focused,
#workspaces button:checked,
button:checked,
button.active {
    background-image: none;
    background-color: rgba(${ACCENT_R}, ${ACCENT_G}, ${ACCENT_B}, 0.85);
    color: ${TEXT_ACTIVE_COLOR};
    box-shadow: none;
    text-shadow: none;
}

/* Hover effect -- a soft neutral fill, no border, on anything not already
   using the accent for its active state. */
#hyprland-workspaces button:hover,
#workspaces button:hover,
.modules-left widget > *:hover {
    background-image: none;
    background-color: rgba(${TEXT_ACTIVE_R}, ${TEXT_ACTIVE_G}, ${TEXT_ACTIVE_B}, 0.08);
    color: ${TEXT_ACTIVE_COLOR};
}

#tray > .needs-attention {
    background-color: rgba(${ACCENT_R}, ${ACCENT_G}, ${ACCENT_B}, 0.4);
    border-radius: 8px;
}

/* App-shortcut icons (launcher + custom taskbar buttons) size independently
   from the clock/volume/network/etc text modules above. A real dock
   should feel tactile: icons grow slightly on hover, like they're
   lifting toward the cursor, instead of just swapping a flat background
   tint the way a plain text button does. GTK CSS has no transform/scale,
   so the "lift" is a font-size step with a spring-ish easing curve. */
.app-icon {
    font-size: ${FONT_SIZE_WAYBAR_ICONS}px;
    opacity: 0.85;
    transition: font-size 180ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 160ms cubic-bezier(0.2, 0, 0, 1), color 140ms cubic-bezier(0.2, 0, 0, 1);
}
#waybar.waybar-dock button:hover .app-icon,
#waybar.waybar-dock button:hover.app-icon {
    font-size: ${FONT_SIZE_WAYBAR_ICONS_HOVER}px;
    opacity: 1;
}
