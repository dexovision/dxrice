* {
    font-family: "${FONT_FAMILY}", sans-serif;
    font-size: ${FONT_SIZE_WAYBAR}px;
    -gtk-icon-shadow: none;
}

window {
    background: transparent;
}

.qs-root {
    background-color: rgba(${BG_R}, ${BG_G}, ${BG_B}, ${OPACITY_ACTIVE});
    border: 1px solid rgba(${BORDER_R}, ${BORDER_G}, ${BORDER_B}, ${BORDER_OPACITY_ACTIVE});
    border-radius: ${RADIUS}px;
    color: ${TEXT_COLOR};
    padding: 10px;
}

.qs-header {
    padding: 2px 4px 8px 4px;
    font-weight: bold;
    font-size: 1.05em;
    color: ${TEXT_ACTIVE_COLOR};
}

.qs-close {
    min-width: 22px;
    min-height: 22px;
    padding: 0;
    border-radius: ${ENTRY_RADIUS}px;
    background: transparent;
    color: ${TEXT_COLOR};
    border: none;
    transition: background-color 120ms ease-out;
}

.qs-close:hover {
    background-color: rgba(${BORDER_R}, ${BORDER_G}, ${BORDER_B}, 0.15);
}

.qs-card {
    background-color: rgba(${ACTIVE_R}, ${ACTIVE_G}, ${ACTIVE_B}, ${OPACITY_IDLE});
    border: 1px solid rgba(${BORDER_R}, ${BORDER_G}, ${BORDER_B}, ${BORDER_OPACITY_IDLE});
    border-radius: ${ENTRY_RADIUS}px;
    padding: 8px;
    margin-bottom: 8px;
}

.qs-card:last-child {
    margin-bottom: 0;
}

.qs-row {
    padding: 4px 2px;
    color: ${TEXT_COLOR};
}

.qs-row-title {
    font-weight: 600;
    color: ${TEXT_ACTIVE_COLOR};
}

.qs-row-subtitle {
    font-size: 0.9em;
    opacity: 0.75;
}

/* Compact icon-toggle grid (Wi-Fi / Bluetooth / DND) */
.qs-toggle {
    background-color: rgba(${BG_R}, ${BG_G}, ${BG_B}, ${OPACITY_IDLE});
    border: 1px solid rgba(${BORDER_R}, ${BORDER_G}, ${BORDER_B}, ${BORDER_OPACITY_IDLE});
    border-radius: ${ENTRY_RADIUS}px;
    color: ${TEXT_COLOR};
    padding: 8px 4px;
    transition: background-color 120ms ease-out, border-color 120ms ease-out, color 120ms ease-out;
}

.qs-toggle:hover {
    border-color: rgba(${BORDER_R}, ${BORDER_G}, ${BORDER_B}, ${BORDER_OPACITY_ACTIVE});
}

.qs-toggle.active {
    background-color: rgba(${ACCENT_R}, ${ACCENT_G}, ${ACCENT_B}, 0.85);
    border-color: rgba(${ACCENT_R}, ${ACCENT_G}, ${ACCENT_B}, 1);
    color: ${TEXT_ACTIVE_COLOR};
}

/* List rows inside a card (wifi networks, bluetooth devices, clipboard) */
.qs-list-row {
    padding: 6px 4px;
    border-radius: ${ENTRY_RADIUS}px;
    transition: background-color 120ms ease-out;
}

.qs-list-row:hover {
    background-color: rgba(${BORDER_R}, ${BORDER_G}, ${BORDER_B}, 0.12);
}

/* Sliders (volume, mic, brightness) */
scale trough {
    background-color: rgba(${BORDER_R}, ${BORDER_G}, ${BORDER_B}, 0.25);
    border-radius: ${ENTRY_RADIUS}px;
    min-height: 6px;
}

scale trough highlight {
    background-color: rgba(${ACCENT_R}, ${ACCENT_G}, ${ACCENT_B}, 0.9);
    border-radius: ${ENTRY_RADIUS}px;
}

scale slider {
    background-color: ${TEXT_ACTIVE_COLOR};
    border-radius: 50%;
    min-width: 14px;
    min-height: 14px;
    margin: 0;
}

/* Live usage bars (CPU / RAM / disk) */
levelbar block {
    background-color: rgba(${BORDER_R}, ${BORDER_G}, ${BORDER_B}, 0.25);
    border-radius: ${ENTRY_RADIUS}px;
    min-height: 6px;
}

levelbar block.filled {
    background-color: rgba(${ACCENT_R}, ${ACCENT_G}, ${ACCENT_B}, 0.9);
}

/* Small icon buttons (media controls, power row, connect/disconnect) */
.qs-icon-btn {
    background-color: rgba(${BG_R}, ${BG_G}, ${BG_B}, ${OPACITY_IDLE});
    border: 1px solid rgba(${BORDER_R}, ${BORDER_G}, ${BORDER_B}, ${BORDER_OPACITY_IDLE});
    border-radius: ${ENTRY_RADIUS}px;
    color: ${TEXT_COLOR};
    padding: 6px;
    transition: background-color 120ms ease-out, color 120ms ease-out;
}

.qs-icon-btn:hover {
    background-color: rgba(${BORDER_R}, ${BORDER_G}, ${BORDER_B}, 0.18);
    color: ${TEXT_ACTIVE_COLOR};
}

.qs-power-btn.destructive:hover {
    background-color: rgba(${ACCENT_R}, ${ACCENT_G}, ${ACCENT_B}, 0.85);
    border-color: rgba(${ACCENT_R}, ${ACCENT_G}, ${ACCENT_B}, 1);
    color: ${TEXT_ACTIVE_COLOR};
}

.qs-muted {
    color: rgba(${ACCENT_R}, ${ACCENT_G}, ${ACCENT_B}, 1);
}

switch {
    border-radius: ${ENTRY_RADIUS}px;
    background-color: rgba(${BORDER_R}, ${BORDER_G}, ${BORDER_B}, 0.25);
}

switch:checked {
    background-color: rgba(${ACCENT_R}, ${ACCENT_G}, ${ACCENT_B}, 0.9);
}

switch slider {
    background-color: ${TEXT_ACTIVE_COLOR};
    border-radius: 50%;
}
