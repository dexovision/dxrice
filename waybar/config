{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 8,
    "margin-left": 14,
    "margin-right": 14,
    "spacing": 10,
    "modules-left": [
        "custom/launcher",
        "custom/firefox",
        "custom/discord",
        "custom/sober",
        "custom/terminal",
        "custom/files"
    ],
    "modules-center": [
        "hyprland/workspaces",
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "tray"
    ],
    "custom/launcher": {
        "format": "\udb82\udcc7",
        "on-click": "wofi --show drun",
        "tooltip": true,
        "tooltip-format": "App Launcher"
    },
    "custom/firefox": {
        "format": "\uf269",
        "on-click": "sh -c '/usr/lib/firefox/firefox >/dev/null 2>&1 &'",
        "tooltip": true,
        "tooltip-format": "Firefox"
    },
    "custom/discord": {
        "format": "\udb81\ude6f",
        "on-click": "discord",
        "tooltip": true,
        "tooltip-format": "Discord"
    },
    "custom/files": {
        "format": "\uf07b",
        "on-click": "nautilus",
        "tooltip": true,
        "tooltip-format": "Files"
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    "clock": {
        "format": "{:%H:%M   %b %d}"
    },
    "pulseaudio": {
        "format": "Vol {volume}%",
        "format-muted": "Muted",
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "Wifi {signalStrength}%",
        "format-ethernet": "Ethernet",
        "format-disconnected": "Offline",
        "on-click": "nm-connection-editor"
    },
    "cpu": {
        "format": "CPU {usage}%"
    },
    "memory": {
        "format": "RAM {percentage}%"
    },
    "custom/sober": {
        "format": "\uf11b",
        "on-click": "sh -c 'flatpak run org.vinegarhq.Sober >/dev/null 2>&1 &'",
        "tooltip": true,
        "tooltip-format": "Sober"
    },
    "custom/terminal": {
        "format": "\uf120",
        "on-click": "sh -c 'kitty >/dev/null 2>&1 &'",
        "tooltip": true,
        "tooltip-format": "Terminal"
    }
}